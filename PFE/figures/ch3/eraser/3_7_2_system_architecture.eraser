title CAVIX — System Architecture (3.7.2)

// ── zones ─────────────────────────────────────────────
Lab [color: red, icon: aws-vpc] {
  attacker      [icon: terminal, label: "Kali attacker"]
  caldera       [icon: bug, label: "MITRE Caldera (C2)"]
  victim1       [icon: ubuntu, label: "Victim 1 (Ubuntu 22.04)"]
  victim2       [icon: ubuntu, label: "Victim 2"]
  sandcat1      [icon: gear, label: "Sandcat agent"]
  sandcat2      [icon: gear, label: "Sandcat agent"]
}

Telemetry [color: orange, icon: aws-vpc] {
  auditd        [icon: file-text, label: "auditd\n(52 kill-chain rules)"]
  wazuh_agent   [icon: shield, label: "Wazuh agent"]
  wazuh_manager [icon: shield, label: "Wazuh manager\n(alerts.json)"]
  filebeat      [icon: elastic, label: "Filebeat\n(1 s tail → Redis)"]
}

Backend [color: blue, icon: aws-vpc] {
  redis    [icon: redis, label: "Redis\n(Streams + queues)"]
  api      [icon: server, label: "FastAPI service\n(~20 routes)"]
  workers  [icon: gear, label: "7 background workers"]
  models   [icon: cpu, label: "5-model ensemble\n+ DQN"]
  postgres [icon: postgresql, label: "PostgreSQL\n+ TimescaleDB"]
}

External [color: gray, icon: aws-vpc] {
  urlhaus    [icon: cloud, label: "URLhaus\n(abuse.ch)"]
  feodo      [icon: cloud, label: "Feodo Tracker\n(abuse.ch)"]
  virustotal [icon: cloud, label: "VirusTotal"]
  claude     [icon: cloud, label: "Anthropic\nClaude API"]
  expo_push  [icon: cloud, label: "Expo Push"]
}

Clients [color: teal, icon: aws-vpc] {
  web    [icon: monitor, label: "Next.js Web Console\n(:5600)"]
  mobile [icon: smartphone, label: "Expo Mobile\nCompanion"]
}

// ── edges ─────────────────────────────────────────────
attacker      > caldera        : "operator UI"
caldera       > sandcat1       : "abilities (C2)"
caldera       > sandcat2       : "abilities (C2)"
sandcat1      --> victim1      : "executes on"
sandcat2      --> victim2      : "executes on"
victim1       > auditd         : "syscalls"
victim1       > wazuh_agent    : "ossec events"
victim2       > wazuh_agent    : "ossec events"
auditd        > wazuh_agent    : "audit-wazuh-*"
wazuh_agent   > wazuh_manager  : "encrypted (1514)"
wazuh_manager > filebeat       : "alerts.json"
filebeat      > redis          : "RPUSH strix:alerts:raw:list"
redis         <> workers       : "Streams (XADD/XREAD)"
workers       > models         : "load (SHA-256-pinned)"
workers       > postgres       : "INSERT verdicts, chains"
api           <> postgres      : "SQLAlchemy async"
api           <> redis         : "session, rate-limit"
api           > urlhaus        : "feed pull (30 s)"
api           > feodo          : "feed pull (30 s)"
api           > virustotal     : "on-demand IOC scan"
api           > claude         : "case summaries"
api           > expo_push      : "push to mobile"
web           <> api           : "REST + SSE"
mobile        <> api           : "REST + SSE + Push"
