    <mxCell id="cls-LlmInsightCache" value="&lt;i&gt;«entity»&lt;/i&gt;&lt;br&gt;&lt;b&gt;LlmInsightCache&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ payload_hash : str  &lt;b&gt;(PK)&lt;/b&gt;&lt;br&gt;+ generated_at : datetime&lt;br&gt;+ model_version : str&lt;br&gt;+ insight : str&lt;br&gt;+ recommended_actions : JSONB&lt;br&gt;+ expires_at : datetime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1440" y="452" width="260" height="128" as="geometry"/></mxCell>
    <mxCell id="cls-ModelRegistry" value="&lt;i&gt;«service»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ModelRegistry&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ active_calibrator : str =&lt;br&gt;&#160;&#160;&#x27;Beta-VAE (Top 25) lab-refit&#x27;&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ load(name, version) : nn.Module&lt;br&gt;+ verify_sha256(path, expected) : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="260" height="114" as="geometry"/></mxCell>
    <mxCell id="cls-RegularizedAutoencoder" value="&lt;i&gt;«model»&lt;/i&gt;&lt;br&gt;&lt;b&gt;RegularizedAutoencoder&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;- encoder : nn.Sequential&lt;br&gt;- fc_mu : Linear(128 → 64)&lt;br&gt;- fc_logvar : Linear(128 → 64)&lt;br&gt;- decoder : nn.Sequential&lt;br&gt;- center : Parameter(zeros(64))&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ forward(x) → dict {mu, logvar,&lt;br&gt;&#160;&#160;recon, recon_error, anomaly_score}&lt;br&gt;+ encode(x), decode(z)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="788" width="260" height="170" as="geometry"/></mxCell>
    <mxCell id="cls-BetaVAE" value="&lt;i&gt;«model»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BetaVAE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;- encoder : Sequential 55→512→256→128&lt;br&gt;- fc_z_mean : Linear(128 → 32)&lt;br&gt;- fc_z_log_var : Linear(128 → 32)&lt;br&gt;- decoder : Sequential 32→128→256→512→55&lt;br&gt;- center : Parameter(zeros(32))&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ forward(x) → dict {z_mean, z_log_var,&lt;br&gt;&#160;&#160;recon_loss, malicious_prob, uncertainty}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="788" width="260" height="156" as="geometry"/></mxCell>
    <mxCell id="cls-Transformer" value="&lt;i&gt;«model»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Transformer&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;- input_projection : Linear(64 → 128)&lt;br&gt;&#160;&#160;+ LayerNorm + ReLU&lt;br&gt;- pos_encoder : Sinusoidal (d=128, len=500)&lt;br&gt;- transformer_encoder : 4 × EncoderLayer&lt;br&gt;&#160;&#160;(8 heads, d_ff=512, GELU, PreLN)&lt;br&gt;- output_head : Linear(128 → 64)&lt;br&gt;&#160;&#160;+ ReLU + Linear(64 → 8)&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ forward(seq : Tensor[T, 64]) →&lt;br&gt;&#160;&#160;{logits, pred_ckc, confidence,&lt;br&gt;&#160;&#160;probabilities}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="788" width="260" height="198" as="geometry"/></mxCell>
    <mxCell id="cls-GraphSAGE" value="&lt;i&gt;«model»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GraphSAGE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;- convs : ModuleList[&lt;br&gt;&#160;&#160;SAGEConv(55 → 128),&lt;br&gt;&#160;&#160;SAGEConv(128 → 128) × 2]&lt;br&gt;- bns : BatchNorm(128) × 3&lt;br&gt;- head : Linear(128 → 64)&lt;br&gt;&#160;&#160;+ ReLU + Linear(64 → 1) + Sigmoid&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ forward(x, edge_index) → Tensor[N]&lt;br&gt;&#160;&#160;(per-node risk ∈ [0, 1])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1160" y="788" width="260" height="170" as="geometry"/></mxCell>
    <mxCell id="cls-DQN" value="&lt;i&gt;«model»&lt;/i&gt;&lt;br&gt;&lt;b&gt;DQN&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;- network : nn.Sequential&lt;br&gt;&#160;&#160;Linear(13 → 128) + ReLU + Dropout&lt;br&gt;&#160;&#160;Linear(128 → 64) + ReLU + Dropout&lt;br&gt;&#160;&#160;Linear(64 → 5)&lt;br&gt;&lt;hr&gt;&lt;br&gt;+ forward(state : Tensor[13]) →&lt;br&gt;&#160;&#160;Tensor[5]  (Q-values)&lt;br&gt;+ select_action(state) : int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1440" y="788" width="260" height="156" as="geometry"/></mxCell>
