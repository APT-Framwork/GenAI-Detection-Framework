        <mxCell id="b6" value="Expo push&#10;(if CKC ≤ S2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane-backend">
          <mxGeometry x="1150" y="85" width="130" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="b7" value="actions_service.apply()&#10;via API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane-backend">
