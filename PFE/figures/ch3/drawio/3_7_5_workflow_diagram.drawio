        <mxCell id="a-dec-approve" value="Approve&#10;DQN action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane-analyst">
          <mxGeometry x="1360" y="55" width="130" height="80" as="geometry"/>
