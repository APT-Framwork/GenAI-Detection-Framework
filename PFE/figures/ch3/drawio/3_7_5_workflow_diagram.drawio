        <mxCell id="b8" value="case_audit_log row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane-backend">
          <mxGeometry x="1560" y="85" width="160" height="50" as="geometry"/>
