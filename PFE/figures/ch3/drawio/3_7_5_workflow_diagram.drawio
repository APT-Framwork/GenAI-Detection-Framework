        <mxCell id="a-dec-resolve" value="Resolve or&#10;escalate?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane-analyst">
