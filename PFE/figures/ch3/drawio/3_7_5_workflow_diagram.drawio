        <mxCell id="e10" value="dashboard / phone" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;fontSize=10;" edge="1" parent="1" source="b6" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
