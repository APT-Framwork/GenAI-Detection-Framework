        <mxCell id="a2" value="Opens Attack Analysis&#10;reads forensic report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane-analyst">
