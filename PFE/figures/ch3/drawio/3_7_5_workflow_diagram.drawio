        <mxCell id="e14" value="reject" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;fontSize=10;" edge="1" parent="1" source="a-dec-approve" target="a3-no"><mxGeometry relative="1" as="geometry"/></mxCell>
