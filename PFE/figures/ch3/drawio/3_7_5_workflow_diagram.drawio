        <!-- Footnote -->
        <mxCell id="footnote" value="&lt;b&gt;Note&lt;/b&gt;: Auto-everything is OFF in production. The DQN agent &lt;i&gt;proposes&lt;/i&gt; an action; the analyst &lt;i&gt;decides&lt;/i&gt;. Decision diamonds mark every human-in-the-loop branch." style="text;html=1;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#888;spacing=6;" vertex="1" parent="1">
