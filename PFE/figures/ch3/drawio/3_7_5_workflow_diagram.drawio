        <mxCell id="a4-resolve" value="triage_status =&#10;'resolved'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane-analyst">
