        <mxCell id="e6" value="no" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;fontSize=10;" edge="1" parent="1" source="b-dec-gate" target="b4-no"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;" edge="1" parent="1" source="b4-yes" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;" edge="1" parent="1" source="b4-no" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
