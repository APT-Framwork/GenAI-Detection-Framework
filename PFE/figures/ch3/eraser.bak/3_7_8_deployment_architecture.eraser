title STRIX — Deployment Architecture (3.7.8)

Host "Developer host (16 GB RAM · Docker engine)" {

  strix_net [color: blue, label: "Docker network: strix_net (platform)"] {
    pg          [icon: postgresql, label: "strix_postgres\ntimescale/timescaledb:2.17.2-pg16\n5435:5432\nvol postgres_data"]
    rd          [icon: redis,      label: "strix_redis\nredis:7-alpine\n6380:6379\nvol redis_data"]
    api         [icon: server,     label: "strix_api\nFastAPI · 8000:8000\nmount apps/models (ro)"]
    wbridge     [icon: gear,       label: "strix_wazuh_bridge"]
    norm        [icon: gear,       label: "strix_normalizer"]
    inf         [icon: cpu,        label: "strix_inference_shard0\nmount apps/models (ro)"]
    vw          [icon: gear,       label: "strix_verdicts_writer"]
    arq         [icon: gear,       label: "strix_arq"]
    intel       [icon: gear,       label: "strix_intel_feeds"]
    prom        [icon: bar-chart,  label: "strix_prometheus\n9091:9090\nprometheus.yml"]
    graf        [icon: bar-chart,  label: "strix_grafana\n3000:3000\ndashboards JSON"]
  }

  strix_lab_net [color: red, label: "Docker network: strix_lab_net (simulation)"] {
    wmgr        [icon: shield,    label: "strix_wazuh_manager\nwazuh/wazuh-manager:4.5.2\n1514, 1514/udp, 1515, 55000"]
    cald        [icon: bug,       label: "strix_caldera\nUI :8888 · C2 7010/7011/7012\npayload 8080"]
    v1          [icon: ubuntu,    label: "strix_victim1\nubuntu:22.04\n+ wazuh-agent + auditd\n+ Sandcat"]
    v2          [icon: ubuntu,    label: "strix_victim2\nubuntu:22.04\n+ wazuh-agent + auditd\n+ Sandcat"]
    att         [icon: terminal,  label: "strix_attacker\nkalilinux/kali-rolling\nrecon_burst.sh"]
    fb          [icon: elastic,   label: "strix_filebeat\nelastic/filebeat:8.15.3\nmounts wazuh alerts (ro)"]
  }

  HostProcs [color: green, label: "Host-network (Honcho-managed)"] {
    nextjs   [icon: monitor, label: "Next.js dev\nhost:5600  (pnpm dev)"]
    honcho   [icon: gear,    label: "honcho -f Procfile.host start\n(workers alt to make workers)"]
  }
}

External [color: gray, label: "External SaaS (off-host)"] {
  abuse    [icon: cloud, label: "abuse.ch\nURLhaus + Feodo"]
  vt       [icon: cloud, label: "VirusTotal"]
  claude   [icon: cloud, label: "Anthropic Claude"]
  expo     [icon: cloud, label: "Expo Push"]
  github   [icon: github, label: "GitHub (source)"]
}

LaptopBrowsers [color: teal, label: "Operator devices"] {
  web_browser    [icon: monitor,    label: "Web browser\n→ host:5600 + host:8000"]
  mobile_device  [icon: smartphone, label: "Expo dev-client\n→ host:8000"]
}

// platform-network edges
api      <> pg              : "5435"
api      <> rd              : "6380"
wbridge  <> rd
norm     <> rd
inf      <> rd
vw       <> rd
vw       > pg
arq      <> rd
intel    > rd
prom     --> api            : "scrape /metrics"
prom     --> inf            : "scrape"
graf     <> prom            : "datasource"

// lab edges
att      > cald             : "browser to :8888"
cald     > v1               : "Sandcat C2 (7010/7011/7012)"
cald     > v2               : "Sandcat C2"
v1       > wmgr             : "agent → manager (1514)"
v2       > wmgr             : "agent → manager (1514)"
wmgr     > fb               : "alerts.json (mount, ro)"

// cross-network bridge (dashed)
fb       --> rd             : "cross-network RPUSH"

// external
api      > claude           : "summaries"
api      > vt               : "scans"
intel    > abuse            : "30 s feeds"
api      > expo             : "push notifications"

// clients
web_browser   <> nextjs     : "host:5600"
web_browser   <> api        : "host:8000 (REST + SSE)"
mobile_device <> api        : "host:8000 (REST + SSE + Push)"
