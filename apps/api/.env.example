# ============================================================================
# STRIX API — example environment file
# Copy to .env and fill in required values. Never commit .env.
# Required keys will cause the process to refuse to boot if missing.
# ============================================================================

ENV=dev
SERVICE_NAME=strix-api

# ---- Postgres ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=strix
DB_USER=strix
DB_PASSWORD=changeme   # REQUIRED

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Model registry ----
MODELS_PATH=/app/models
MODELS_VERIFY_CHECKSUMS=true

# ---- Wazuh ingestion ----
WAZUH_RAW_STREAM=strix:alerts:raw
WAZUH_RAW_STREAM_MAXLEN=100000
WAZUH_CONSUMER_GROUP=strix-normalizer

# ---- Threat intel (optional; circuit breaker trips when absent) ----
# THREAT_INTEL_HIBP_API_KEY=
# THREAT_INTEL_VIRUSTOTAL_API_KEY=
THREAT_INTEL_BREAKER_FAIL_MAX=5
THREAT_INTEL_BREAKER_RESET_TIMEOUT_SECONDS=30

# ---- LLM (Anthropic) ----
# LLM_ANTHROPIC_API_KEY=
LLM_SENTINEL_MODEL=claude-opus-4-7
LLM_LIVEFEED_MODEL=claude-haiku-4-5-20251001
LLM_SENTINEL_CACHE_TTL_SECONDS=300
LLM_LIVEFEED_LRU_SIZE=10000

# ---- Inference workers ----
INFERENCE_NUM_SHARDS=4
# INFERENCE_SHARD_ID=0   # set per replica
INFERENCE_AE_BATCH_MAX=32
INFERENCE_AE_BATCH_WAIT_MS=20

# ---- Observability ----
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
OBS_METRICS_PORT=9090
OBS_TRACING_ENABLED=false
# OBS_OTLP_ENDPOINT=http://jaeger:4318

# ---- Auth (Phase 0 dev-only) ----
AUTH_DEV_SKIP_AUTH=true          # dev-only bypass; honoured only when ENV=dev
# AUTH_JWT_SECRET=                 # REQUIRED from Phase 4
AUTH_JWT_ACCESS_TTL_MINUTES=15
AUTH_JWT_REFRESH_TTL_DAYS=7
AUTH_AUTO_RESPONSE_ENABLED=false # hard-off in 1.0 (§12 Q3)
