{
  "expo": {
    "name": "CAVIX",
    "slug": "strix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "strix",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e7faff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strix.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e7faff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.strix.mobile",
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e7faff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00f2ff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a569553-169c-4154-8fdd-995b7ef8dbd1"
      }
    },
    "owner": "yacine_na"
  }
}
