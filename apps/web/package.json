    "class-variance-authority": "^0.7.1",
    "next-themes": "^0.4.6",
    "@tanstack/react-query": "^5.62.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/react": "^18.3.23",
