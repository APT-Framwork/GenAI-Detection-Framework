<!--
  STRIX custom rules — layered on top of Wazuh 4.9 default MITRE ruleset.
  Goal: raise alerts for Caldera-emulated APT abilities that the defaults
  miss or under-score. Rule IDs in 100000-109999 (reserved for user rules).

  These chain off the real parent rules that fire when the host's audit
  rules use Wazuh's CDB-known keys (audit-wazuh-{x,w,r,a}):
    80789 = execve (-k audit-wazuh-x) → match on audit.exe
    80784 = write  (-k audit-wazuh-w) → match on audit.file.name
    80785 = read   (-k audit-wazuh-r) → match on audit.file.name
-->
<group name="strix,caldera,">

  <!-- ================= Discovery (TA0007) ================= -->
  <rule id="100100" level="6">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(whoami|id|uname|hostname|uptime|w|last)$</field>
    <description>STRIX: system information discovery command</description>
    <mitre>
      <id>T1082</id>
      <id>T1033</id>
    </mitre>
  </rule>

  <rule id="100101" level="6">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(ps|top|pgrep|pidof)$</field>
    <description>STRIX: process discovery</description>
    <mitre><id>T1057</id></mitre>
  </rule>

  <rule id="100102" level="6">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(netstat|ss|ip|arp|route)$</field>
    <description>STRIX: network configuration / connection discovery</description>
    <mitre>
      <id>T1016</id>
      <id>T1049</id>
    </mitre>
  </rule>

  <rule id="100103" level="6">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(find|locate)$</field>
    <description>STRIX: file &amp; directory discovery</description>
    <mitre><id>T1083</id></mitre>
  </rule>

  <!-- ================= Credential Access (TA0006) ================= -->
  <rule id="100200" level="10">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/etc/(shadow|passwd|gshadow|group)$</field>
    <description>STRIX: write to credential store (/etc/shadow|passwd|group)</description>
    <mitre>
      <id>T1003.008</id>
      <id>T1552.001</id>
    </mitre>
  </rule>

  <rule id="100201" level="8">
    <if_sid>80785</if_sid>
    <field name="audit.file.name" type="pcre2">^/(root|home/[^/]+)/\.ssh/</field>
    <description>STRIX: read on SSH private key material</description>
    <mitre><id>T1552.004</id></mitre>
  </rule>

  <!-- ================= Persistence (TA0003) ================= -->
  <rule id="100300" level="9">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/(etc/(crontab|cron\.(d|hourly|daily))|var/spool/cron)/</field>
    <description>STRIX: cron modification (persistence)</description>
    <mitre><id>T1053.003</id></mitre>
  </rule>

  <rule id="100301" level="9">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/(etc|lib)/systemd/system/</field>
    <description>STRIX: systemd unit modification (persistence)</description>
    <mitre><id>T1543.002</id></mitre>
  </rule>

  <rule id="100302" level="8">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/root/\.(bashrc|profile)$</field>
    <description>STRIX: shell rc file modified (persistence)</description>
    <mitre><id>T1546.004</id></mitre>
  </rule>

  <!-- ================= Privilege Escalation (TA0004) ================= -->
  <rule id="100400" level="9">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/etc/sudoers</field>
    <description>STRIX: sudoers file modified</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>

  <rule id="100401" level="8">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(sudo|su|pkexec)$</field>
    <description>STRIX: privilege-escalation utility executed</description>
    <mitre><id>T1548</id></mitre>
  </rule>

  <!-- ================= Defense Evasion (TA0005) ================= -->
  <rule id="100500" level="10">
    <if_sid>80784</if_sid>
    <field name="audit.file.name" type="pcre2">^/var/log/(wtmp|btmp|lastlog|auth\.log)</field>
    <description>STRIX: tampering with system log files</description>
    <mitre>
      <id>T1070.002</id>
      <id>T1070.003</id>
    </mitre>
  </rule>

  <rule id="100501" level="7">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(base64|xxd|openssl)$</field>
    <description>STRIX: encoding/decoding utility — possible obfuscation</description>
    <mitre><id>T1027</id></mitre>
  </rule>

  <!-- ================= Command & Control (TA0011) / Ingress Tool Transfer ================= -->
  <rule id="100600" level="7">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(wget|curl)$</field>
    <description>STRIX: download utility executed — possible ingress tool transfer</description>
    <mitre>
      <id>T1105</id>
      <id>T1071.001</id>
    </mitre>
  </rule>

  <rule id="100601" level="8">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(nc|ncat)$</field>
    <description>STRIX: netcat executed — possible reverse shell / C2</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1095</id>
    </mitre>
  </rule>

  <!-- ================= Execution (TA0002) — scripting interpreters ================= -->
  <rule id="100700" level="6">
    <if_sid>80789</if_sid>
    <field name="audit.exe" type="pcre2">/(bash|sh|python3?|perl|ruby)$</field>
    <description>STRIX: command/scripting interpreter executed</description>
    <mitre><id>T1059</id></mitre>
  </rule>

</group>
